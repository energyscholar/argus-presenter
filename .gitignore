node_modules/
*.log
.DS_Store
# Plan 0470: ASR scratch (segment WAVs / stub worker counters) never committed
.asr-cache/
*.asr-count
# Plan 0470 (RT-26): opt-in transcript persistence sink stays out of the repo
.transcripts/
/harness/_shots/
test/screenshots/
*.tmp

# Local content modules stay out of the public repo (content is not shipped here; core stays neutral)
modules/*.json
!modules/demo-welcome.json

# Local plugin installs stay out of the public repo (domain plugins are installed
# locally under plugins/<name>/ and are never committed; core stays neutral)
plugins/starship-ops/

# Content SOURCE also stays out (modules/*.json above only covers built output).
# Session decks live in the private campaign repo; core stays neutral.
modules/_src/

# Plan 0522 P12: retirement MOVES a module into modules/_archive/ (it is never deleted). The

# same rule applies as to modules/*.json above — local content stays out of the public repo —

# but the README documenting how to un-retire IS tracked, because a directory whose entire

# purpose is "this is the undo" is useless if the instructions live only in a commit message.

modules/_archive/*

!modules/_archive/README.txt

# Plan 0522 P16.1 (R1): the LOCAL deployment config (port now, more later). Local values —
# a port that matches THIS machine's ingress — are never committed; the documented example is.
/presenter-config.json

# Plan 0534 W1-A: resolve-refs build records (sha256 of what it emitted, so a re-emit
# can tell its own output from a hand-authored module). Runtime state, never tracked.
modules/.resolve-refs/
__pycache__/
*.pyc
*.bak
*.bak-*
*.orig
